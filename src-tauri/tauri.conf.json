{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dashboard",
  "version": "0.1.1",
  "identifier": "io.github.nbroers05.dashboard",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "nbroers05",
    "shortDescription": "Dashboard",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Dutch"]
      }
    }
  }
}
