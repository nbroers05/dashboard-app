{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard-titelbalk",
  "description": "Alleen de titelbalk van het dashboard mag het venster bedienen (slepen, minimaliseren, maximaliseren, sluiten, schermvullend), en alleen vanaf https://nbroers05.github.io/Dashboard/",
  "windows": ["main"],
  "remote": {
    "urls": ["https://nbroers05.github.io/Dashboard/*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}
